# Full original subscription URL. Keep its query string/token intact.
UPSTREAM_URL=https://provider.example/subscription?token=replace-me

# Generate with: openssl rand -hex 24
RELAY_TOKEN=replace-with-at-least-16-random-characters

# Dashboard login. ADMIN_USERNAME defaults to admin.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
# Use false only for local development over http://127.0.0.1.
SECURE_COOKIES=false

# Generate both with: openssl rand -hex 32
APP_ENCRYPTION_KEY=replace-with-a-stable-random-key
SESSION_SECRET=replace-with-another-stable-random-key

# Neon/PostgreSQL is recommended for persistent dashboard state. Without this
# variable the app uses a local SQLite file.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require&channel_binding=require

# Optional settings:
# UPSTREAM_TIMEOUT_SECONDS=20
# MAX_RESPONSE_BYTES=5242880
# SUBSCRIPTION_REFRESH_SECONDS=900
# ALLOW_INSECURE_HTTP=false
